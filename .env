# ==========================================
# Hirly Environment Configuration
# ==========================================

# Application
APP_NAME=Hirely
APP_ENV=development
APP_DEBUG=true
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Database
DATABASE_URL=postgresql+psycopg://hirly:hirly_dev_password@localhost:5432/hirly

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60